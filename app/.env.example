# Copy this file to `.env` (same folder) and fill in real values.
# .env is gitignored — never commit real keys.

# Transcription + speaker diarization: https://console.deepgram.com
DEEPGRAM_API_KEY=

# AI analysis (summary, decisions, actions, gaps): https://console.anthropic.com
ANTHROPIC_API_KEY=

