# Postgres
DATABASE_URL=postgres://recall:recall@localhost:5432/recall

# Auth
JWT_SECRET=change-me-to-a-long-random-string
# Optional: set this to the OLD value when rotating JWT_SECRET, so sessions
# signed with it keep verifying until they expire (30d). Remove once expired.
JWT_SECRET_PREVIOUS=
ALLOWED_EMAIL_DOMAIN=maverio.com

# Production hardening (safe dev defaults — see server/README.md "Production
# deployment" before deploying for real):
# Comma-separated allowed origins, or '*' (default). Set this to the real
# app's origin(s) in production.
CORS_ORIGIN=*
# Set to 1 when running behind a single reverse proxy/load balancer, so rate
# limiting and req.ip see the real client IP instead of the proxy's. Leave
# unset for local dev / direct connections.
TRUST_PROXY=
NODE_ENV=development

# Object storage (S3-compatible: AWS S3, MinIO, R2, etc).
# Leave STORAGE_DRIVER=local to store files on disk instead (dev only).
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=recall-audio
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
LOCAL_STORAGE_DIR=./data/audio

# AI pipeline (server-side only — never sent to clients)
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

PORT=8787

# Days raw meeting audio is kept before the retention job deletes it
# (transcripts/summaries/decisions/actions are unaffected)
AUDIO_RETENTION_DAYS=30

# Optional: enables real cross-meeting voice recognition (Picovoice Eagle,
# https://console.picovoice.ai/). Leave blank to skip it entirely — naming a
# speaker still works, just without voiceprint enrollment/matching.
PICOVOICE_ACCESS_KEY=
