# Postgres
DATABASE_URL=postgres://recall:recall@localhost:5432/recall

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ALLOWED_EMAIL_DOMAIN=maverio.com

# Object storage (S3-compatible: AWS S3, MinIO, R2, etc).
# Leave STORAGE_DRIVER=local to store files on disk instead (dev only).
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=recall-audio
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
LOCAL_STORAGE_DIR=./data/audio

# AI pipeline (server-side only — never sent to clients)
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

PORT=8787
